{
  "name": "awesome-prompts-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/main.js",
    "test": "node --import tsx --test test/*.test.ts web/*.test.ts && python3 -m unittest discover -s examples/python -p 'test_*.py' && node --import tsx skills/ConnectPrompts/Tools/Validate.ts",
    "example:typescript": "tsx examples/typescript/server.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
